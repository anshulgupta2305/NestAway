<% layout("layouts/boilerplate") -%>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">STAY SOMEWHERE SPECIAL</p>
    <h1>Find a place<br><em>you'll love</em> to stay.</h1>
    <p class="hero-text">
      Discover comfortable spaces, beautiful stays and memorable places
      across India.
    </p>
    <a class="hero-button" href="#listings">Explore stays <span>↓</span></a>
  </div>

  <div class="hero-art">
    <div class="hero-image-wrap">
      <img
        src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1100&q=85"
        alt="Beautiful modern accommodation"
      >
    </div>
    <div class="hero-badge">
      <span class="badge-dot"></span>
      <div>
        <strong>Curated stays</strong>
        <small>Made for your next escape</small>
      </div>
    </div>
  </div>
</section>

<section class="listing-section" id="listings">
  <div class="section-heading">
    <div>
      <p class="eyebrow">EXPLORE</p>
      <h2>Popular stays</h2>
    </div>
    <a class="text-link" href="/listings/new">List your place <span>→</span></a>
  </div>

  <% if (listings.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">⌂</div>
      <h2>Your first listing starts here.</h2>
      <p>There are no stays yet. Add an accommodation and make this space yours.</p>
      <a class="hero-button dark" href="/listings/new">Create first listing</a>
    </div>
  <% } else { %>
    <div class="listing-grid">
      <% listings.forEach(listing => { %>
        <article class="listing-card">
          <a href="/listings/<%= listing._id %>" class="card-image-link">
            <div class="card-image-wrap">
              <img src="<%= listing.image %>" alt="<%= listing.title %>" class="card-image">
              <span class="image-pill">Stay</span>
            </div>
          </a>

          <div class="card-content">
            <div class="card-topline">
              <div>
                <h3><%= listing.title %></h3>
                <p><%= listing.location %>, <%= listing.country %></p>
              </div>
              <span class="card-arrow">↗</span>
            </div>

            <p class="card-description"><%= listing.description %></p>

            <div class="card-bottom">
              <span class="price">₹<%= listing.price.toLocaleString("en-IN") %><small> / night</small></span>
              <a href="/listings/<%= listing._id %>" class="view-link">View stay</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
